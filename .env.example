NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/developer_portfolio
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Optional email notifications (messages are still stored if SMTP is not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFICATION_EMAIL=
